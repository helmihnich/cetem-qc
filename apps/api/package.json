{
  "name": "@cetem-qc/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "bootstrap:responsable": "tsx --env-file-if-exists=../../.env src/scripts/bootstrap-responsable.ts",
    "reset:responsable-password": "tsx --env-file-if-exists=../../.env src/scripts/reset-responsable-password.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:calculations": "node --import tsx --test src/modules/calculations/calculations.test.ts"
  },
  "dependencies": {
    "@cetem-qc/domain": "workspace:*",
    "@cetem-qc/i18n": "workspace:*",
    "@cetem-qc/schemas": "workspace:*",
    "@cetem-qc/types": "workspace:*",
    "express": "5.2.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "@types/express": "5.0.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
