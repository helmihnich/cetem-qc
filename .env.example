# Development template. PoV/test templates live in deploy/env/ (Story 12.1); never commit real values.
# Runtime (Story 12.1). Leave empty for the defaults: HOST=127.0.0.1, PORT=3001, TRUST_PROXY off, FORCE_HTTPS off.
# Behind a hosting platform set HOST=0.0.0.0, TRUST_PROXY=true, FORCE_HTTPS=true. APP_ENV is informational (local or pov).
HOST=
PORT=
TRUST_PROXY=
FORCE_HTTPS=
APP_ENV=
# Database (server only). DATABASE_URL wins; NEON_DATABASE_URL is the hosted alias. Both stay empty in git.
DATABASE_URL=
NEON_DATABASE_URL=
# Web server-side API address (default http://127.0.0.1:3001) and mobile public API address.
CETEM_QC_API_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_OFFLINE_AUTHORIZATION_WINDOW_DAYS=
# AI summary draft (Story 10.1). Leave empty for the default "mock" provider (fixed French text, no network, no account).
# Set AI_PROVIDER=gemini to use Google Gemini; the key is read from the server environment only and is never committed.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
# Private object storage for generated report files (Story 11.1). Leave empty for the defaults:
# FILE_STORAGE=local (or memory) and FILE_STORAGE_DIR=.data/files (outside any served directory).
FILE_STORAGE=
FILE_STORAGE_DIR=
# Manual PDF intake (Story 11.2). Leave empty for the defaults: PDF_MAX_BYTES=20971520 (20 MB, never higher),
# ANTIVIRUS=none (records "analyse antivirus non effectuee (PoV)"; set clamav to scan through clamd INSTREAM),
# CLAMAV_HOST=127.0.0.1, CLAMAV_PORT=3310, CLAMAV_TIMEOUT_MS=30000. An unknown ANTIVIRUS value fails at start-up.
PDF_MAX_BYTES=
ANTIVIRUS=
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=
