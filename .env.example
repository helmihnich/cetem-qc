# AI summary draft (Story 10.1). Leave empty for the default "mock" provider (fixed French text, no network, no account).
# Set AI_PROVIDER=gemini to use Google Gemini; the key is read from the server environment only and is never committed.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
# Private object storage for generated report files (Story 11.1). Leave empty for the defaults:
# FILE_STORAGE=local (or memory) and FILE_STORAGE_DIR=.data/files (outside any served directory).
FILE_STORAGE=
FILE_STORAGE_DIR=
# Manual PDF intake (Story 11.2). Leave empty for the defaults: PDF_MAX_BYTES=20971520 (20 MB, never higher),
# ANTIVIRUS=none (records "analyse antivirus non effectuee (PoV)"; set clamav to scan through clamd INSTREAM),
# CLAMAV_HOST=127.0.0.1, CLAMAV_PORT=3310, CLAMAV_TIMEOUT_MS=30000. An unknown ANTIVIRUS value fails at start-up.
PDF_MAX_BYTES=
ANTIVIRUS=
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=
