# Local demo through docker-compose.yml. Copy to deploy/env/compose.env (git-ignored), fill the empty values, then:
#   docker compose --env-file deploy/env/compose.env up --build
POSTGRES_USER=cetem
POSTGRES_DB=cetem_qc
POSTGRES_PASSWORD=
WEB_PORT=3000
# Malware scanning is optional: ANTIVIRUS=none (default) or, with `--profile scan`, ANTIVIRUS=clamav and CLAMAV_HOST=clamav.
ANTIVIRUS=none
CLAMAV_HOST=
# Empty = mock provider (fixed French text). gemini needs GEMINI_API_KEY.
AI_PROVIDER=
GEMINI_API_KEY=
