# API on Render (PoV). Set these in the hosting dashboard only; never commit real values.
APP_ENV=pov
HOST=0.0.0.0
# PORT is provided by the platform; leave it unset on Render.
TRUST_PROXY=true
FORCE_HTTPS=true
# Private Neon connection string (runtime role, sslmode=require). Server only.
NEON_DATABASE_URL=
DATABASE_URL=
# Replaceable ports: local adapter on a persistent disk for the PoV.
FILE_STORAGE=local
FILE_STORAGE_DIR=/var/data/files
PDF_MAX_BYTES=
ANTIVIRUS=none
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=
# Empty = mock provider (fixed French text). gemini needs GEMINI_API_KEY in the dashboard.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
# Technician credential e-mails (Brevo: smtp-relay.brevo.com, port 587). SMTP_PASSWORD in the dashboard only.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
APP_LOGIN_URL=
